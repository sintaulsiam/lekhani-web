{
  "name": "lekhani-web",
  "version": "0.3.0",
  "description": "Official website for Lekhani (লেখনী) — Ultra-Fast Bengali Input Method Suite",
  "main": "index.html",
  "scripts": {
    "build": "tailwindcss -i src/input.css -o style.css --minify",
    "build:css": "tailwindcss -i src/input.css -o style.css --minify",
    "watch:css": "tailwindcss -i src/input.css -o style.css --watch",
    "dev": "tailwindcss -i src/input.css -o style.css --watch",
    "serve": "npx -y serve . -p 3000"
  },
  "keywords": [
    "bengali",
    "keyboard",
    "ime",
    "fcitx5",
    "android",
    "avro",
    "lekhani",
    "rust"
  ],
  "author": "Sintatul Siam",
  "license": "GPL-3.0",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
